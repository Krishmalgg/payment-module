"Messaging": {
  "Provider": "RabbitMq",
  "Parameters": {
    "QueueName": "http://localhost:5201/api/webhooks/notifications/status"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest",
    "Port": "5672",
    "Queues": {
      "AddCard": "payment.addcard.requests",
      "PaymentIntent": "payment.initiate.requests",
      "GetStoredCards": "payment.getstoredcards.requests",
      "GetStoredCardsResponse": "main-server.payment-responses.queue",
      "Refund": "payment.refund.requests",
      "RefundResponse": "main-server.refund-responses.queue"
    }
  }
},
  "PaymentServer": {
    "CommunicationMode": "Http"
  },
  "AllowedHosts": "*"
}
