{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=payment_module_dev;Username=postgres;Password=postgres;Port=5432"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/payment-module-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/api/v1/payments/*",
        "Period": "1m",
        "Limit": 10
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "PaymentGateway": {
    "Provider": "PayHere"
  },
  "PayHere": {
    "MerchantId": "1210000",
    "MerchantSecret": "4C4...SECRET...ABC",
    "CheckoutUrl": "https://sandbox.payhere.lk/pay/checkout",
    "ReturnUrl": "http://localhost:5173/payment/return",
    "CancelUrl": "http://localhost:5173/payment/cancel",
    "NotifyUrl": "http://localhost:5000/api/v1/payments/webhook"
  },
  "AllowedHosts": "*"
}